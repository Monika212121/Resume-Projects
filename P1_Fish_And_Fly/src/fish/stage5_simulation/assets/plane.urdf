<?xml version="1.0" ?>
<robot name="simple_plane">
  <link name="plane_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <plane normal="0 0 1"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <plane normal="0 0 1"/>
      </geometry>
      <material name="checker">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
  </link>
</robot>
