<?xml version="1.0" ?>
<robot name="fish_robot">

  <link name="base_link">
    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.4 0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.5 1.0 1.0"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.4 0.2"/>
      </geometry>
    </collision>

    <!-- Inertial (REQUIRED by PyBullet) -->
    <inertial>
      <mass value="5"/>
      <inertia
        ixx="0.2" ixy="0" ixz="0"
        iyy="0.2" iyz="0"
        izz="0.2"/>
    </inertial>
  </link>

</robot>
